# Normalize line endings to LF on commit across OSes (Windows / WSL / macOS).
# Prevents CRLF churn when switching machines.
* text=auto eol=lf

# Binary files: never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
